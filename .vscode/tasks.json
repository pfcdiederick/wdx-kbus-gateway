{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make (native, PC)",
            "type": "shell",
            "command": "make",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "run simulation (http://localhost:8000)",
            "type": "shell",
            "command": "make run-sim",
            "isBackground": false,
            "problemMatcher": []
        },
        {
            "label": "test: reference + bulk + wdx (simulation on port 8000)",
            "type": "shell",
            "command": "python3 tools/test-rest.py 127.0.0.1 sim && python3 tools/test-rest.py 127.0.0.1 bulk && python3 tools/test-rest.py 127.0.0.1 wda",
            "problemMatcher": []
        },
        {
            "label": "build-ipk: PFC300 (arm64)",
            "type": "shell",
            "command": "tools/build-ipk.sh arm64",
            "problemMatcher": []
        },
        {
            "label": "deploy to PFC (build, opkg install, status)",
            "type": "shell",
            "command": "tools/deploy.sh ${input:pfcIp}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "pfcIp",
            "type": "promptString",
            "description": "IP address of the PFC",
            "default": "192.168.1.17"
        }
    ]
}
