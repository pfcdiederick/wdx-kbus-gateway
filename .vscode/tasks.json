{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make (native)",
            "type": "shell",
            "command": "make",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "run simulation (http://localhost:8000)",
            "type": "shell",
            "command": "make run-sim",
            "isBackground": false,
            "problemMatcher": []
        },
        {
            "label": "buildx: image for PFC (linux/arm/v7)",
            "type": "shell",
            "command": "docker buildx build --platform linux/arm/v7 -t kbus-gateway:latest --load .",
            "problemMatcher": []
        },
        {
            "label": "buildx: simulation image (linux/amd64)",
            "type": "shell",
            "command": "docker buildx build --platform linux/amd64 --build-arg REQUIRE_ADI=0 -t kbus-gateway:sim --load .",
            "problemMatcher": []
        },
        {
            "label": "deploy to PFC",
            "type": "shell",
            "command": "tools/deploy.sh ${input:pfcAddress}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "pfcAddress",
            "type": "promptString",
            "description": "IP address of the PFC",
            "default": "192.168.1.17"
        }
    ]
}
