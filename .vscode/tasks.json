{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make (native, PC)",
            "type": "shell",
            "command": "make",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run simulation (http://localhost:8000)",
            "type": "shell",
            "command": "make run-sim",
            "isBackground": false,
            "problemMatcher": []
        },
        {
            "label": "test: wdx data layer (simulation on port 8000)",
            "type": "shell",
            "command": "python3 tests/test-rest.py 127.0.0.1 wda",
            "problemMatcher": []
        },
        {
            "label": "build-ipk: PFC300 (arm64)",
            "type": "shell",
            "command": "tools/build-ipk.sh arm64",
            "problemMatcher": []
        },
        {
            "label": "deploy native package to PFC (build, opkg install, status)",
            "type": "shell",
            "command": "tools/deploy.sh ${input:pfcIp}",
            "problemMatcher": []
        },
        {
            "label": "deploy containers: manager only",
            "type": "shell",
            "command": "tools/deploy-docker.sh ${input:pfcIp} --manager --no-gateway",
            "problemMatcher": []
        },
        {
            "label": "deploy containers: IEC 104 server only",
            "type": "shell",
            "command": "tools/deploy-docker.sh ${input:pfcIp} --iec104 --no-gateway",
            "problemMatcher": []
        },
        {
            "label": "deploy containers: gateway + manager + example client",
            "type": "shell",
            "command": "tools/deploy-docker.sh ${input:pfcIp} --manager --client",
            "problemMatcher": []
        },
        {
            "label": "gateway container -> native service",
            "type": "shell",
            "command": "tools/deploy-docker.sh ${input:pfcIp} --native",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "pfcIp",
            "type": "promptString",
            "description": "IP address of the PFC",
            "default": "192.168.1.17"
        }
    ]
}
